{
  "name": "storyloom",
  "version": "0.1.0",
  "private": true,
  "description": "여백 — 로컬 세계관과 캐릭터 창작 작업실",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "macos": "react-native run-macos",
    "windows": "react-native run-windows",
    "web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build:web"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "18.2.3",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "react-native-windows": "0.81.35",
    "react-native-safe-area-context": "5.10.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "14.0.1",
    "sql.js": "1.14.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-env": "7.28.3",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "@babel/plugin-transform-export-namespace-from": "7.29.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
